## https://raw.githubusercontent.com/igvteam/igv/master/src/main/resources/org/broad/igv/prefs/preferences.tab

DEFAULT_GENOME_KEY=hg38

##Track Display
SAM.SHOW_COV_TRACK=TRUE
SAM.SHOW_ALIGNMENT_TRACK=FALSE
SAM.SHOW_JUNCTION_TRACK=FALSE

##Downsampling
SAM.DOWNSAMPLE_READS=FALSE

##Alignment Track Options
SAM.COLOR_BY=BASE_MODIFICATION_5MC
SAM.GROUP_OPTION=PHASE
SAM.SHOW_MISMATCHES=TRUE
SAM.QUICK_CONSENSUS_MODE=TRUE
SAM.MAX_VISIBLE_RANGE=8000

SAM.FILTER_DUPLICATES=FALSE
SAM.FILTER_SECONDARY_ALIGNMENTS=TRUE
SAM.FILTER_FAILED_READS=FALSE
SAM.FILTER_SUPPLEMENTARY_ALIGNMENTS=FALSE

SAM.DISPLAY_MODE=COLLAPSED
SAM.SHOW_CENTER_LINE=FALSE
SAM.SHOW_SOFT_CLIPPED=TRUE

SAM.HIDE_SMALL_INDEL=TRUE
SAM.SMALL_INDEL_BP_THRESHOLD=100

SAM.SHOW_INSERTION_MARKERS=FALSE

SAM.SORT_OPTION=INSERT_SIZE


